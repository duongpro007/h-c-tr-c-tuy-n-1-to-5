# URL công khai của website (dùng cho SEO: sitemap.xml, Open Graph, robots.txt)
NEXT_PUBLIC_SITE_URL=https://hocmachoi.vn

# Cấu hình SMTP để form Liên hệ gửi được email (ví dụ dùng Hostinger Email hoặc Gmail SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@hocmachoi.vn
SMTP_PASS=your-smtp-password

# Email nhận tin nhắn liên hệ từ website
CONTACT_TO_EMAIL=duongpro007@gmail.com

# Cổng chạy server Node.js (PM2 sẽ dùng biến này)
PORT=3000
