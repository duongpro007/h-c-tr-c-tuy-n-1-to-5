# Cấu hình Nginx reverse proxy cho hoc-ma-choi (Next.js chạy qua PM2 ở cổng 3000)
# Sao chép nội dung này vào /etc/nginx/sites-available/hocmachoi.vn trên VPS Hostinger,
# sau đó tạo symlink sang sites-enabled và chạy `sudo certbot --nginx` để cấp SSL miễn phí.

server {
    listen 80;
    listen [::]:80;
    server_name hocmachoi.vn www.hocmachoi.vn;

    # Giới hạn kích thước body cho form liên hệ
    client_max_body_size 2m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
